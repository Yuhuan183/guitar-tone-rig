  "routing": [
    { "from": "friedman-ir-d.balanced-out", "to": "uafx-ox-stomp.input-1", "signal": "mono-line-level-or-lower", "notes": "IR-D Cab IR Bypass；保留 Power Amp Simulation。" },
    { "from": "uafx-ox-stomp.output-1-2", "to": "monitoring.input-1-2", "signal": "stereo", "notes": "雙輸出才能保留立體聲 Room、Delay 與 Reverb。" }
  ],
  "safetyRules": [
    { "rule": "OX Stomp 不是 Load Box，不可連接任何音箱 Speaker Output。", "devices": ["uafx-ox-stomp"] },
    { "rule": "IR-D 的 Cab IR 必須 Bypass，避免與 OX Stomp 重複箱體模擬。", "devices": ["friedman-ir-d", "uafx-ox-stomp"] },
    { "rule": "NOTADÜMBLË Drive、Ive 高 Gain 與 IR-D Ch.2 不要同時大量削波。", "devices": ["notadumble-v2", "petla-ive", "friedman-ir-d"] }
  ],
  "calibration": {
    "title": "第一次校正流程",
    "steps": [
      "關閉 Cali76、NOTADÜMBLË Drive、Ive 與 OX Master FX，只建立 IR-D Ch.1＋OX Clean Rig。",
      "打開 NOTADÜMBLË Clean，用 Output 校正 Level，再用 Input 調厚薄。",
      "調 Cali76 IN：一般彈奏亮兩顆、重撥短暫三顆；用 OUT／DRY 對齊音量。",
      "打開 Ive，確認 Ch.1 Crunch 不會過薄；必要時只把 Saturation Cut 移到 8:30–9:00。",
      "建立 IR-D Ch.2 單獨的 Hard Rock，先肥而不糊；再開 Ive 收緊成 Metal。",
      "最後調 NOTADÜMBLË Drive 與 OX Lead Rig，校正 Solo Level。",
      "在實際演奏音量重新檢查 Bass、Room 與 OX Output。"
    ]
  },
  "diagnostics": [
    { "symptom": "Clean 太平、缺少 Pick Attack", "check": "檢查 Cali76 Attack 是否太快、Gain Reduction 是否經常超過 5 dB。", "devices": ["cali76"] },
    { "symptom": "Metal 糊又吵", "check": "關閉 Cali76、降低 Ive Gain，並確認 IR-D Gain 沒有超過實際需求。", "devices": ["cali76", "petla-ive", "friedman-ir-d"] },
    { "symptom": "Metal 太薄", "check": "Ive Saturation Cut 由全左移到 8:30–9:00，保留 IR-D Middle。", "devices": ["petla-ive", "friedman-ir-d"] },
    { "symptom": "OX 音量比 Bypass 小", "check": "Output 從約 3 點往上校正，同時檢查 Mic 1／2 Level。", "devices": ["uafx-ox-stomp"] }
  ],
  "openSlots": [
    {
      "id": "noise-gate",
      "label": "Gate",
      "problem": "多顆 Gain 不會讓 Gate 失效，真正的問題是偵測位置。只放在 IR-D 前，消不掉 IR-D 真空管前級自身的 Hiss；只放在所有失真之後，又會用嚴重失真的訊號判斷開關，吞掉尾音。",
      "topology": ["Guitar → Gate Input", "Gate Send → Cali76 → NOTADÜMBLË → Ive → IR-D Input", "IR-D FX Send → Gate Return", "Gate Output → IR-D FX Return → OX Stomp"],
      "rules": [
        "Threshold 只比靜止噪音高一點，不為絕對安靜犧牲自然尾音。",
        "Clean／Low Gain 使用 Reduction；Metal 才用快速 Gate。",
        "Gate 只能讓休止時安靜，不能移除音符中的 Hum／Hiss。",
        "先查隔離電源、接地、Patch Cable 與單線圈方向，再提高 Threshold。",
        "IR-D 單獨使用非接地電源與耳機可能增加 Hum；接到有接地的介面或 Monitor 可改善。",
        "四線法可能形成地迴路；Pylon 的 Transformer／Ground Lift 對這類情境有實際用途。"
      ],
      "candidates": [
        {
          "name": "KMA Machines Pylon",
          "verdict": "最符合需求",
          "url": "https://kmamachines.com/machines/pylon/",
          "notes": "VCA Gate＋最高 30 dB Transformer Boost，Low Cut 約 65–730 Hz、6 dB/oct；四線法可包住整段 Gain Chain，Ground Lift 也能處理部分地迴路。"
        },
        { "name": "BOSS NS-1X", "verdict": "自然尾音", "url": "https://www.boss.info/global/products/ns-1x/", "notes": "Reduction 適合 Clean／Low Gain，Gate 適合快速 Metal Rhythm；沒有 Boost／EQ，但控制自然。" },
        { "name": "Horizon Precision Drive", "verdict": "Ive 替代", "url": "https://horizondevices.com/products/precision-drive", "notes": "Metal Tightening、Attack、Boost 加簡易 Gate；位於 IR-D 前，無法完整處理前級 Hiss。" }
      ]
    }
  ],
